<UserControl x:Class="TIAOpennessStudio.Controls.LibraryCompareControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="txtWindowTitle" Text="Library Versioning" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="txtWindowSubtitle" Text="User-level operation. Independent from AI internal version/index management."
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{DynamicResource CodePanelBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="6">
            <TabItem x:Name="tabBackup" Header="Backup">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblBackupSource" Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Source File"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtBackupSource" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Padding="6"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="btnBrowseBackupSource" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="100" Margin="0,0,0,8" Click="BrowseBackupSource_Click"/>

                    <TextBlock x:Name="lblBackupRoot" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Backup Root"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtBackupRoot" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" Padding="6"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="btnBrowseBackupRoot" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="100" Margin="0,0,0,8" Click="BrowseBackupRoot_Click"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,10">
                        <Button x:Name="btnCreateBackup" Content="Create Backup" Padding="14,6" MinWidth="130" Click="CreateBackup_Click"/>
                        <Button x:Name="btnRefreshHistory" Content="Refresh History" Padding="14,6" MinWidth="130" Margin="10,0,0,0" Click="RefreshHistory_Click"/>
                        <Button x:Name="btnRestoreBackup" Content="Restore Selected" Padding="14,6" MinWidth="140" Margin="10,0,0,0" Click="RestoreBackup_Click" IsEnabled="False"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtBackupHistoryTitle" Text="Backup History" Margin="0,0,0,8" Foreground="{DynamicResource AccentBrush}"/>
                                <ListBox x:Name="lstBackupHistory" Grid.Row="1" SelectionChanged="BackupHistory_SelectionChanged"
                                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                         DisplayMemberPath="Display"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBox x:Name="txtBackupLog" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabCompare" Header="Compare">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblCompareLeft" Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Left File"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtLeftPath" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Padding="6"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="btnBrowseLeft" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="100" Margin="0,0,0,8" Click="BrowseLeft_Click"/>

                    <TextBlock x:Name="lblCompareRight" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Right File"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtRightPath" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" Padding="6"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="btnBrowseRight" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="100" Margin="0,0,0,8" Click="BrowseRight_Click"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,10">
                        <Button x:Name="btnCompare" Content="Run Compare" Padding="14,6" MinWidth="130" Click="RunCompare_Click"/>
                        <Button x:Name="btnExportXml" Content="Export XML" Padding="14,6" MinWidth="120" Margin="10,0,0,0" Click="ExportCompareXml_Click" IsEnabled="False"/>
                        <TextBlock x:Name="lblFilter" Text="Filter" Margin="14,6,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox x:Name="cmbCompareFilter" Width="170" Margin="0,0,8,0" SelectionChanged="CompareFilter_SelectionChanged">
                            <ComboBoxItem Tag="all" Content="All" IsSelected="True"/>
                            <ComboBoxItem Tag="diff" Content="Only Differences"/>
                            <ComboBoxItem Tag="left" Content="Only Left"/>
                            <ComboBoxItem Tag="right" Content="Only Right"/>
                            <ComboBoxItem Tag="same" Content="Same"/>
                        </ComboBox>
                        <TextBlock x:Name="txtCompareSummary" Margin="12,6,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <DataGrid x:Name="gridCompareResults" Grid.Row="3" Grid.ColumnSpan="3" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colCategory" Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn x:Name="colPath" Header="Path" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn x:Name="colName" Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn x:Name="colLeft" Header="Left" Binding="{Binding Left}" Width="*"/>
                            <DataGridTextColumn x:Name="colRight" Header="Right" Binding="{Binding Right}" Width="*"/>
                            <DataGridTextColumn x:Name="colStatus" Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="txtProgress" Text="Ready." Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
