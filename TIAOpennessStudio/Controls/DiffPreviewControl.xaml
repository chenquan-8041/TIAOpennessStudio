<UserControl x:Class="TIAOpennessStudio.Controls.DiffPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="{DynamicResource CodePanelBrush}"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblTitle"
                               Text="Code Diff"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeLg}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblStats"
                               Text=""
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="btnViewMode"
                                  Content="Side by Side"
                                  Width="100" Height="26"
                                  Margin="0,0,8,0"
                                  IsChecked="True"
                                  Click="btnViewMode_Click"
                                  ToolTip="Toggle side-by-side / unified view"/>
                    <ToggleButton x:Name="btnEditMode"
                                  Content="Edit"
                                  Width="80" Height="26"
                                  Margin="0,0,8,0"
                                  Click="btnEditMode_Click"
                                  ToolTip="Edit the modified code manually"/>
                    <Button x:Name="btnReject"
                            Content="Reject"
                            Width="80" Height="26"
                            Margin="0,0,8,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="btnReject_Click"/>
                    <Button x:Name="btnApply"
                            Content="Apply"
                            Width="80" Height="26"
                            Style="{StaticResource CompactButtonStyle}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Click="btnApply_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="gridBody">
            <Grid x:Name="gridSideBySide">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CodePanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="lblOriginal"
                                   Grid.Row="0"
                                   Text="Original"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Padding="8,4"
                                   Background="{DynamicResource PanelAltBrush}"/>
                        <avalonedit:TextEditor x:Name="editorLeft"
                                               Grid.Row="1"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeMd}"
                                               ShowLineNumbers="False"
                                               IsReadOnly="True"
                                               Padding="4"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="2"
                              Background="{DynamicResource BorderBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              IsEnabled="False"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource CodePanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="lblModified"
                                   Grid.Row="0"
                                   Text="Modified"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Padding="8,4"
                                   Background="{DynamicResource PanelAltBrush}"/>
                        <avalonedit:TextEditor x:Name="editorRight"
                                               Grid.Row="1"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeMd}"
                                               ShowLineNumbers="False"
                                               IsReadOnly="True"
                                               Padding="4"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="borderUnified"
                    Background="{DynamicResource CodePanelBrush}"
                    Visibility="Collapsed">
                <avalonedit:TextEditor x:Name="editorUnified"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="{StaticResource FontSizeMd}"
                                       ShowLineNumbers="True"
                                       IsReadOnly="True"
                                       Padding="4"/>
            </Border>

            <Border x:Name="borderEdit"
                    Background="{DynamicResource CodePanelBrush}"
                    Visibility="Collapsed">
                <avalonedit:TextEditor x:Name="editorManualEdit"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="{StaticResource FontSizeMd}"
                                       ShowLineNumbers="True"
                                       IsReadOnly="False"
                                       Padding="4"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock x:Name="lblStatus"
                       Text="Review the changes, then click Apply to write back to TIA Portal."
                       Foreground="{DynamicResource InputHintBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
