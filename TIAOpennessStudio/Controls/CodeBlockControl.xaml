<UserControl x:Class="TIAOpennessStudio.Controls.CodeBlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">

    <UserControl.Resources>
        <!--  Compact, borderless action button used in the code card header  -->
        <Style x:Key="CodeBlockActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AgentTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AgentHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AgentTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource AgentCardCodeBrush}"
            BorderBrush="{DynamicResource AgentCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,4"
            Padding="0">
        <!-- Code header -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource AgentCardCodeHeaderBrush}" Padding="10,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnSave" Click="Save_Click" Style="{StaticResource CodeBlockActionButton}" />
                        <Button x:Name="btnInsert" Click="Insert_Click" Style="{StaticResource CodeBlockActionButton}" />
                        <Button x:Name="btnCopy" Click="Copy_Click" Style="{StaticResource CodeBlockActionButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LanguageLabel"
                                   Foreground="{DynamicResource AgentTextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileNameLabel"
                                   Foreground="{DynamicResource AgentTextThoughtBrush}"
                                   FontSize="{StaticResource FontSizeXs}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Code content -->
            <avalonedit:TextEditor x:Name="CodeEditor"
                                   FontFamily="{StaticResource AgentCodeFontFamily}"
                                   FontSize="{StaticResource FontSizeMd}"
                                   Foreground="{DynamicResource AgentTextPrimaryBrush}"
                                   Background="Transparent"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="{DynamicResource AgentTextThoughtBrush}"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   MaxHeight="300"
                                   Padding="12,8"/>
        </DockPanel>
    </Border>
</UserControl>