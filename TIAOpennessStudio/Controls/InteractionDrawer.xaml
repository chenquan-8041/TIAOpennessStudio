<UserControl
    x:Class="TIAOpennessStudio.Controls.InteractionDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="420"
    mc:Ignorable="d"
    Focusable="True"
    KeyDown="Drawer_KeyDown">

    <!--
        Sits directly above the chat input box. Collapsed unless a request is showing.
        Height is animated through ClipToBounds + a ScaleTransform on the card so the drawer
        "slides up" instead of popping in. All colours come from theme resources.
    -->
    <Border
        x:Name="DrawerRoot"
        Margin="0,0,0,6"
        Background="{DynamicResource PanelBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="8"
        Visibility="Collapsed">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="0" />
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Risk stripe: accent for normal, amber for medium, red for destructive  -->
            <Border x:Name="RiskStripe" Grid.Column="0" Background="{DynamicResource AccentBrush}" />

            <StackPanel Grid.Column="1" Margin="12,8,12,10">

                <!--  Header: title + queue position + countdown  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TitleText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeLg}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock
                            x:Name="QueueText"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeXs}"
                            Foreground="{DynamicResource InputHintBrush}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="CountdownText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeXs}"
                            Foreground="{DynamicResource InputHintBrush}" />
                    </StackPanel>
                </Grid>

                <!--  Summary is plain text on purpose: no markup, nothing the model wrote gets interpreted  -->
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,4,0,0"
                    FontSize="{StaticResource FontSizeMd}"
                    Foreground="{DynamicResource MutedTextBrush}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="SourceText"
                    Margin="0,3,0,0"
                    FontSize="{StaticResource FontSizeXs}"
                    Foreground="{DynamicResource InputHintBrush}"
                    TextTrimming="CharacterEllipsis" />

                <!--  Optional details (for example a diff)  -->
                <Button
                    x:Name="DetailToggle"
                    Margin="0,6,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DetailToggle_Click"
                    Cursor="Hand"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{DynamicResource AccentBrush}"
                    Visibility="Collapsed" />
                <TextBox
                    x:Name="DetailBox"
                    Margin="0,4,0,0"
                    MaxHeight="160"
                    Padding="6,4"
                    Background="{DynamicResource CodePanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{DynamicResource TextBrush}"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed" />

                <!--  Merged approval batch: one compact row per queued write  -->
                <ItemsControl
                    x:Name="BatchList"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="8,5"
                                Background="{DynamicResource CodePanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeMd}"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXs}"
                                        Foreground="{DynamicResource InputHintBrush}"
                                        Text="{Binding Summary}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Choose: one button per option  -->
                <ItemsControl
                    x:Name="OptionsList"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,0,4"
                                Padding="10,6"
                                HorizontalContentAlignment="Left"
                                Click="Option_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Tag="{Binding Id}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeMd}"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding Label}" />
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXs}"
                                        Foreground="{DynamicResource InputHintBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Input: free text  -->
                <TextBox
                    x:Name="InputBox"
                    Margin="0,8,0,0"
                    MaxHeight="90"
                    Padding="6,4"
                    AcceptsReturn="True"
                    Background="{DynamicResource CodePanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CaretBrush="{DynamicResource TextBrush}"
                    FontSize="{StaticResource FontSizeMd}"
                    Foreground="{DynamicResource TextBrush}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed" />

                <!--  Remember checkbox, only for approvals that allow it  -->
                <CheckBox
                    x:Name="RememberCheck"
                    Margin="0,8,0,0"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Visibility="Collapsed" />

                <!--  Buttons: Deny on the left so the destructive default is never under the right thumb  -->
                <StackPanel
                    x:Name="ButtonRow"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="DenyButton"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Click="Deny_Click"
                        Style="{StaticResource ModernButtonStyle}" />
                    <Button
                        x:Name="AllowButton"
                        MinWidth="72"
                        Padding="12,5"
                        Background="{DynamicResource AccentBrush}"
                        Click="Allow_Click"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        Style="{StaticResource ModernButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
