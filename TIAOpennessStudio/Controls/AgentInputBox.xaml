<UserControl
    x:Class="TIAOpennessStudio.Controls.AgentInputBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80"
    d:DesignWidth="600"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Padding="0"
        Background="{DynamicResource PanelBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Top mode tab bar  -->
            <Border
                Grid.Row="0"
                Padding="12,5"
                Background="{DynamicResource WindowTitleBarBrush}"
                CornerRadius="8,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Margin="0,0,8,0"
                        Padding="6,2"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXs}"
                                Foreground="White"
                                Text="✦" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSm}"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Agent" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="ModeHintText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource InputHintBrush}"
                        Text="Chat with the AI assistant to generate PLC code" />
                </StackPanel>
            </Border>

            <!--  Input area  -->
            <Grid Grid.Row="1" Margin="10,6">
                <!--  Multiline input  -->
                <TextBox
                    x:Name="InputTextBox"
                    MinHeight="24"
                    MaxHeight="120"
                    Padding="4,2"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource TextBrush}"
                    FontFamily="Segoe UI, Microsoft YaHei UI"
                    FontSize="{StaticResource FontSizeLg}"
                    Foreground="{DynamicResource TextBrush}"
                    KeyDown="InputTextBox_KeyDown"
                    Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="InputTextBox_TextChanged"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!--  Image preview area  -->
            <Grid
                x:Name="ImagePreviewGrid"
                Grid.Row="2"
                Margin="10,0,10,4"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl
                    x:Name="ImagePreviewList"
                    Grid.Column="0"
                    HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="56"
                                Height="56"
                                Margin="0,0,6,0"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Image
                                        Source="{Binding}"
                                        Stretch="UniformToFill" />
                                    <Button
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#CC333333"
                                        BorderThickness="0"
                                        Content="✕"
                                        FontSize="9"
                                        Foreground="White"
                                        Click="RemoveImage_Click"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    x:Name="ClearImagesBtn"
                    Grid.Column="1"
                    Padding="4,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="✕ Clear"
                    Click="ClearImages_Click"
                    Cursor="Hand"
                    FontSize="{StaticResource FontSizeXs}"
                    Foreground="{DynamicResource InputHintBrush}" />
            </Grid>

            <!--  Bottom toolbar  -->
            <Border
                Grid.Row="3"
                Padding="10,5"
                Background="{DynamicResource WindowTitleBarBrush}"
                CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left: access-mode switch, @ and # buttons  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="AccessModeButton"
                            Padding="4,2"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AccessModeButton_Click"
                            Cursor="Hand"
                            FontSize="{StaticResource FontSizeSm}"
                            Foreground="{DynamicResource InputHintBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="AccessModeIcon"
                                    Margin="0,0,3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeSm}"
                                    Text="🔒" />
                                <TextBlock
                                    x:Name="AccessModeLabel"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeSm}"
                                    Text="Read-only" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="AtButtonBottom"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AtButton_Click"
                            Content="@"
                            Cursor="Hand"
                            FontSize="{StaticResource FontSizeSm}"
                            Foreground="{DynamicResource InputHintBrush}"
                            ToolTip="Reference files (@)" />
                        <Button
                            x:Name="HashButtonBottom"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="HashButton_Click"
                            Content="#"
                            Cursor="Hand"
                            FontSize="{StaticResource FontSizeSm}"
                            Foreground="{DynamicResource InputHintBrush}"
                            ToolTip="Quick commands (#)" />
                    </StackPanel>

                    <!--  Image upload button  -->
                    <Button
                        x:Name="ImageButton"
                        Grid.Column="1"
                        Padding="4,2"
                        Margin="4,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ImageButton_Click"
                        Content="🖼"
                        Cursor="Hand"
                        FontSize="{StaticResource FontSizeMd}"
                        Foreground="{DynamicResource InputHintBrush}"
                        ToolTip="Paste or upload an image" />

                    <!--  Center: model selector  -->
                    <ComboBox
                        x:Name="ModelSelector"
                        Grid.Column="2"
                        Width="120"
                        MinWidth="120"
                        MaxWidth="205"
                        Margin="15,3,0,4"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource TextBrush}"
                        SelectionChanged="ModelSelector_SelectionChanged">
                        <ComboBoxItem Content="qwen2.5:3b" IsSelected="True" />
                    </ComboBox>

                    <!--  Token usage display  -->
                    <StackPanel
                        x:Name="TokenUsagePanel"
                        Grid.Column="3"
                        Margin="10,0,5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TokenUsageText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeXs}"
                            Foreground="{DynamicResource InputHintBrush}"
                            Text="" />
                        <Button
                            x:Name="CompressBtn"
                            Margin="6,0,0,0"
                            Padding="4,1"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Click="CompressBtn_Click"
                            Content="Compress"
                            Cursor="Hand"
                            FontSize="9"
                            Foreground="{DynamicResource TextBrush}"
                            ToolTip="Compress the message history to free up tokens"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  Right: send/stop button  -->
                    <StackPanel
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            x:Name="SendStopBorder"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="6"
                            Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.3"
                                    ShadowDepth="0"
                                    Color="#4A90E2" />
                            </Border.Effect>
                            <Button
                                x:Name="SendStopButton"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SendStopButton_Click"
                                ToolTip="Send (Enter)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#5A9FE8" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#3A7FC8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!--  Send arrow icon (pointing up, more modern design)  -->
                                    <Path
                                        x:Name="SendIcon"
                                        Width="14"
                                        Height="14"
                                        Margin="0,-1,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M12,2 L12,18 M12,2 L7,7 M12,2 L17,7"
                                        Stretch="Uniform"
                                        Stroke="White"
                                        StrokeThickness="2.5">
                                        <Path.StrokeStartLineCap>Round</Path.StrokeStartLineCap>
                                        <Path.StrokeEndLineCap>Round</Path.StrokeEndLineCap>
                                    </Path>
                                    <!--  Stop square icon (hidden by default)  -->
                                    <Rectangle
                                        x:Name="StopIcon"
                                        Width="10"
                                        Height="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="White"
                                        RadiusX="2"
                                        RadiusY="2"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  @ mention Popup  -->
            <Popup
                x:Name="AtMentionPopup"
                AllowsTransparency="True"
                Placement="Top"
                PlacementTarget="{Binding ElementName=InputTextBox}"
                PopupAnimation="Fade"
                StaysOpen="False">
                <Border
                    Width="300"
                    MaxHeight="220"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Search box  -->
                        <Border
                            Grid.Row="0"
                            Padding="6,4"
                            Background="{DynamicResource WindowTitleBarBrush}">
                            <TextBox
                                x:Name="AtSearchBox"
                                Padding="4,2"
                                Background="{DynamicResource ButtonBackground}"
                                BorderThickness="0"
                                CaretBrush="{DynamicResource TextBrush}"
                                FontSize="{StaticResource FontSizeMd}"
                                Foreground="{DynamicResource TextBrush}" />
                        </Border>

                        <!--  Result list  -->
                        <ListBox
                            x:Name="AtMentionList"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            KeyDown="AtMentionList_KeyDown"
                            MouseDoubleClick="AtMentionList_MouseDoubleClick"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeMd}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📄" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RefType}" Value="Variable">
                                                            <Setter Property="Text" Value="🔤" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RefType}" Value="Function">
                                                            <Setter Property="Text" Value="🔧" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RefType}" Value="Udt">
                                                            <Setter Property="Text" Value="📦" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeMd}"
                                            Foreground="{DynamicResource TextBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeXs}"
                                            Foreground="{DynamicResource InputHintBrush}"
                                            Text="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
