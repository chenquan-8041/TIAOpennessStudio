<UserControl
    x:Class="TIAOpennessStudio.Controls.CacheManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource CodePanelBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row 0: Worker Status  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,4"
                    Orientation="Horizontal">
                    <Ellipse
                        x:Name="dotStatus"
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource WarningBrush}" />
                    <TextBlock
                        x:Name="txtWorkerState"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXl}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextBrush}"
                        Text="Worker: --" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnStart"
                        Width="70"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="8,0"
                        Click="BtnStart_Click"
                        Content="Start"
                        FontSize="{StaticResource FontSizeMd}" />
                    <Button
                        x:Name="btnStop"
                        Width="70"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="8,0"
                        Click="BtnStop_Click"
                        Content="Stop"
                        FontSize="{StaticResource FontSizeMd}" />
                    <Button
                        x:Name="btnRestart"
                        Width="70"
                        Height="26"
                        Padding="8,0"
                        Click="BtnRestart_Click"
                        Content="Restart"
                        FontSize="{StaticResource FontSizeMd}" />
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MaxWidth="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="URL: " /><Run x:Name="runUrl" Text="--" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="2"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="PID: " /><Run x:Name="runPid" Text="--" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="4"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="Token: " /><Run x:Name="runToken" Text="--" />
                    </TextBlock>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="Log: " /><Run x:Name="runLogPath" Text="--" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="2"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="Cache: " /><Run x:Name="runCachePath" Text="--" />
                    </TextBlock>
                    <StackPanel
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="68"
                            Height="22"
                            Margin="0,0,6,0"
                            Padding="6,0"
                            Click="BtnOpenLog_Click"
                            Content="Open Log"
                            FontSize="{StaticResource FontSizeSm}" />
                        <Button
                            Width="68"
                            Height="22"
                            Padding="6,0"
                            Click="BtnOpenDir_Click"
                            Content="Open Dir"
                            FontSize="{StaticResource FontSizeSm}" />
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="Index: " /><Run x:Name="runIndexState" Text="--" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="2"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="Blocks: " /><Run x:Name="runBlockCount" Text="--" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="4"
                        FontSize="{StaticResource FontSizeSm}"
                        Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="Dirty: " /><Run x:Name="runDirtyCount" Text="--" />
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!--  Row 1: Cache operations  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="btnRebuild"
                    Width="110"
                    Height="26"
                    Margin="0,0,8,0"
                    Padding="10,0"
                    Click="BtnRebuild_Click"
                    Content="Rebuild Index"
                    FontSize="{StaticResource FontSizeMd}" />
                <Button
                    x:Name="btnClear"
                    Width="100"
                    Height="26"
                    Margin="0,0,8,0"
                    Padding="10,0"
                    Click="BtnClear_Click"
                    Content="Clear Cache"
                    FontSize="{StaticResource FontSizeMd}" />
                <TextBlock
                    x:Name="txtActionStatus"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="" />
            </StackPanel>
        </Border>

        <!--  Row 2: Log label + auto-refresh  -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeMd}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="Worker Log" />
                <CheckBox
                    x:Name="chkAutoRefresh"
                    VerticalAlignment="Center"
                    Checked="ChkAutoRefresh_Changed"
                    Content="Auto-refresh (3s)"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="True"
                    Unchecked="ChkAutoRefresh_Changed" />
                <Button
                    Width="60"
                    Height="22"
                    Margin="8,0,0,0"
                    Padding="6,0"
                    Click="BtnRefreshLog_Click"
                    Content="Refresh"
                    FontSize="{StaticResource FontSizeSm}" />
            </StackPanel>
        </Grid>

        <!--  Row 3: Log viewer  -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource PanelAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <TextBox
                x:Name="txtLog"
                AcceptsReturn="True"
                Background="{DynamicResource PanelAltBrush}"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="{StaticResource FontSizeSm}"
                Foreground="{DynamicResource TextBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="Loading..."
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
