<UserControl x:Class="TIAOpennessStudio.Controls.SettingsCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TIAOpennessStudio.Helpers">
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Width="600" HorizontalAlignment="Left">

            <!-- AI Configuration Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,15" Padding="20">
                <StackPanel>
                    <TextBlock Text="AI Configuration" FontSize="{StaticResource FontSizeXxl}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>

                    <!-- Execution Mode -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Execution Mode" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbExecutionMode" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="LocalGateway" Tag="LocalGateway"/>
                            <ComboBoxItem Content="Direct" Tag="Direct"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Provider -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Provider" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbProvider" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                            <ComboBoxItem Content="Ollama" Tag="Ollama"/>
                            <ComboBoxItem Content="Custom" Tag="Custom"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Model -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Model" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtModel" Width="300" HorizontalAlignment="Left" FontSize="{StaticResource FontSizeMd}"/>
                    </StackPanel>

                    <!-- Reasoning Effort -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Reasoning Effort" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbReasoningEffort" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="High" Tag="high"/>
                            <ComboBoxItem Content="Medium" Tag="medium"/>
                            <ComboBoxItem Content="Low" Tag="low"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- API Key -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="API Key" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtApiKey" Width="300" HorizontalAlignment="Left" FontSize="{StaticResource FontSizeMd}"/>
                    </StackPanel>

                    <!-- Endpoint -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Endpoint" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEndpoint" Width="400" HorizontalAlignment="Left" FontSize="{StaticResource FontSizeMd}"/>
                    </StackPanel>

                    <!-- Local Backend URL -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Local Backend URL" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLocalBackend" Width="300" HorizontalAlignment="Left" FontSize="{StaticResource FontSizeMd}" Text="http://127.0.0.1:8000"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="btnTestConnection" Content="Test Connection" Width="120" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="btnSaveConfig" Content="Save" Width="80" Height="30" Background="{DynamicResource AccentBrush}" Foreground="White"/>
                    </StackPanel>

                    <!-- Test Result -->
                    <TextBlock x:Name="txtTestResult" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Local Model (Ollama) Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,15" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Local Model (Ollama)" FontSize="{StaticResource FontSizeXxl}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Ellipse x:Name="ollamaStatusDot" Width="8" Height="8" Fill="Gray" Margin="10,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtOllamaStatus" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Text="Checking..."/>
                        <TextBlock x:Name="txtOllamaMemory" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Installed Models List -->
                    <TextBlock Text="Installed Models:" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <ItemsControl x:Name="ollamaModelList" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,3" CornerRadius="3"
                                        Background="{DynamicResource SecondaryBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SizeMB, StringFormat={}{0:F0}}"/><Run Text=" MB"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Details}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource SuccessBrush}" Text="✓ Default"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Set Default" Width="90" Height="26"
                                                FontSize="{StaticResource FontSizeSm}" Margin="10,0,6,0"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="OnSetDefaultModel"
                                                Tag="{Binding Name}"
                                                Visibility="{Binding IsNotDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Grid.Column="3" Content="×" Width="28" Height="26"
                                                FontSize="{StaticResource FontSizeXl}" FontWeight="Bold" Padding="0"
                                                Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0"
                                                Click="OnDeleteModel"
                                                Tag="{Binding Name}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtNoModels" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="No local models installed. Use 'ollama pull &lt;model&gt;' in terminal to download, then click Refresh."/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="btnRefreshOllama" Content="Refresh" Width="80" Height="26" FontSize="{StaticResource FontSizeSm}"
                                Style="{StaticResource CompactButtonStyle}"
                                Click="OnRefreshOllama"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Custom Models (Cloud / API) Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,15" Padding="20">
                <StackPanel>
                    <TextBlock Text="Custom Models (Cloud / API)" FontSize="{StaticResource FontSizeXxl}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                    <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Models saved via the Save button above. Configure Provider / API Key / Endpoint first, then Save to register the model."/>

                    <ItemsControl x:Name="customModelsList" Margin="0,0,0,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,3" CornerRadius="3"
                                        Background="{DynamicResource SecondaryBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" FontSize="{StaticResource FontSizeLg}"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="×" Width="28" Height="26"
                                                FontSize="{StaticResource FontSizeXl}" FontWeight="Bold" Padding="0"
                                                Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0"
                                                Click="OnDeleteCustomModel"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtNoCustomModels" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,5" TextWrapping="Wrap"
                               Text="No custom models saved yet."/>
                </StackPanel>
            </Border>

            <!-- Agent Status Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,15" Padding="20">
                <StackPanel>
                    <TextBlock Text="Agent" FontSize="{StaticResource FontSizeXxl}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Engine:" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtAgentEngine" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" Text="ReAct (Dynamic)"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Iterations:" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtMaxIterations" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" Text="20"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tools:" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtToolCount" FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" Text="Loading..."/>
                    </Grid>

                    <CheckBox x:Name="chkRepairEvolution"
                              Click="OnRepairEvolutionToggled"
                              Content="Self-Evolution (repair experience)"
                              FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource TextBrush}"
                              Margin="0,12,0,0"
                              ToolTip="Record code-generation trajectories and let the LLM distill repair experiences (error → root cause → fix), queried on demand by the agent. On by default."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
