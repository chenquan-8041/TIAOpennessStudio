<UserControl x:Class="TIAOpennessStudio.Controls.OpcUaMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource CodePanelBrush}">
    <UserControl.Resources>
        <!--  Localized at runtime by ApplyLanguage (replaces the string resource in place)  -->
        <sys:String x:Key="OpcWriteValueTip">Enter the value to write, then press Enter or click Write</sys:String>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top title bar (UaExpert Data Access View style) -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SidebarBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource GridAccentTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="lblMonitorTitle" Text="Data Access View" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLg}"
                           VerticalAlignment="Center" Foreground="{DynamicResource WindowTitleTextBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeSm}" Margin="16,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource InputHintBrush}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                  Style="{StaticResource AppDataGridStyle}"
                  IsReadOnly="True"
                  FontFamily="Consolas"
                  FontSize="{StaticResource FontSizeMd}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colName" Header="Name" Binding="{Binding DisplayName}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colNodeId" Header="NodeId" Binding="{Binding NodeId}" Width="2*"
                                    ElementStyle="{StaticResource AppGridMutedTextStyle}"/>
                <!-- Value column: shown in accent color -->
                <DataGridTextColumn x:Name="colValue" Header="Value" Binding="{Binding Value}" Width="130"
                                    ElementStyle="{StaticResource AppGridAccentTextStyle}"/>
                <!-- Write column: enter target value + Write button (or Enter key). Writes are gated by the "allow write" safety switch on the connection side. -->
                <DataGridTemplateColumn x:Name="colWrite" Header="Write" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="90" Height="20" Margin="0,0,3,0" Padding="0"
                                         FontSize="{StaticResource FontSizeSm}" VerticalContentAlignment="Center"
                                         ToolTip="{DynamicResource OpcWriteValueTip}"
                                         Text="{Binding WriteInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.WriteNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="Write" Height="20" Padding="6,0" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.WriteNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="colType" Header="Type" Binding="{Binding DataType}" Width="90"/>
                <!-- Quality column: color badge distinguishes Good/Bad/Uncertain -->
                <DataGridTemplateColumn x:Name="colQuality" Header="Quality" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource NeutralBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="Uncertain">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Quality}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource WindowTitleTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="colTimestamp" Header="Timestamp" Binding="{Binding Timestamp}" Width="110"
                                    ElementStyle="{StaticResource AppGridMutedTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Padding="12,5" Background="{DynamicResource SidebarBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <TextBlock x:Name="lblFooter" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource InputHintBrush}"/>
        </Border>
    </Grid>
</UserControl>
