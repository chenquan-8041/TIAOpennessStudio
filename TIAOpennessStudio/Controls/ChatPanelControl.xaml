<UserControl
    x:Class="TIAOpennessStudio.Controls.ChatPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TIAOpennessStudio.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TIAOpennessStudio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="lblAiTitle"
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeSm}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="Code Generator"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="btnNewChat"
                    Width="24"
                    Height="24"
                    Margin="0,0,2,0"
                    Click="NewChat_Click"
                    Content="&#xE710;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="{StaticResource FontSizeXs}"
                    Foreground="{DynamicResource TextBrush}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTip="New Chat" />
                <Button
                    x:Name="btnChatHistory"
                    Width="24"
                    Height="24"
                    Click="ChatHistory_Click"
                    Content="&#xE81C;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="{StaticResource FontSizeXs}"
                    Foreground="{DynamicResource TextBrush}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTip="Chat History" />
            </StackPanel>
        </Grid>

        <!--  Message List (Trae Style)  -->
        <controls:TraeMessageList
            x:Name="TraeMessageList"
            Grid.Row="1"
            Margin="0,0,0,10" />

        <!--  Non-modal toast (e.g. soft tool-call limit); never blocks the run  -->
        <Border
            x:Name="borderToast"
            Grid.Row="1"
            MaxWidth="380"
            Margin="12,12,12,12"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="10"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <TextBlock
                x:Name="txtToast"
                FontSize="{StaticResource FontSizeSm}"
                Foreground="{DynamicResource TextBrush}"
                TextWrapping="Wrap" />
        </Border>

        <!--  Reference Chips (own row so they never overlap the message list)  -->
        <Border
            x:Name="borderReferences"
            Grid.Row="2"
            Margin="0,0,0,4"
            Padding="4"
            VerticalAlignment="Bottom"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <WrapPanel x:Name="wrapReferences" />
        </Border>

        <!--  Input Area: the interaction drawer sits directly above the input box  -->
        <StackPanel Grid.Row="3">
            <controls:InteractionDrawer x:Name="AgentInteractionDrawer" />
            <controls:AgentInputBox
                x:Name="AgentInputBox"
                Margin="0" />
        </StackPanel>

        <!--  Code Preview Helper Popup  -->
        <Popup
            x:Name="popCodePreview"
            AllowsTransparency="True"
            Placement="Center"
            StaysOpen="False">
            <Border
                Width="600"
                Height="400"
                Padding="15"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="Generated SCL Preview" />
                        <Button
                            x:Name="btnClosePreview"
                            Padding="10,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="✕"
                            Foreground="{DynamicResource InputHintBrush}"
                            ToolTip="Close Preview" />
                    </Grid>
                    <TextBox
                        x:Name="txtPreview"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Background="{DynamicResource CodePanelBrush}"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource TextBrush}"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
