<UserControl
    x:Class="TIAOpennessStudio.Controls.TraeMessageList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TIAOpennessStudio.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:TIAOpennessStudio.Models"
    d:DesignHeight="450"
    d:DesignWidth="600"
    Background="{DynamicResource PanelAltBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <controls:MessageBlockTemplateSelector
            x:Key="MessageBlockSelector"
            CodeTemplate="{StaticResource CodeBlockTemplate}"
            CommandTemplate="{StaticResource CommandExecutionBlockTemplate}"
            ContextRefTemplate="{StaticResource ContextRefBlockTemplate}"
            DefaultTemplate="{StaticResource DefaultBlockTemplate}"
            FileChangeTemplate="{StaticResource FileChangeBlockTemplate}"
            StatusTemplate="{StaticResource AgentStatusBlockTemplate}"
            ProgressTemplate="{StaticResource PlanProgressBlockTemplate}"
            TextTemplate="{StaticResource TextBlockTemplate}"
            ThoughtTemplate="{StaticResource ThoughtBlockTemplate}" />

        <!--  Animation resources  -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SlideInStoryboard">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="10"
                To="0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  Typing indicator animation  -->
        <Storyboard x:Key="TypingIndicatorStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetProperty="Opacity"
                From="0.3"
                To="1"
                Duration="0:0:0.5" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!--  Main message list  -->
        <ScrollViewer
            x:Name="MainScrollViewer"
            Padding="16,8"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="MessagesItemsControl" ItemsSource="{Binding Messages, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,4"
                            Padding="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource SlideInStoryboard}" />
                                </EventTrigger>
                            </Border.Triggers>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!--  Message role label  -->
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="FlowDirection" Value="RightToLeft" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Source="{Binding RoleIconPath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Margin" Value="4,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        FontSize="{StaticResource FontSizeSm}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding AgentRoleLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Text" Value="{Binding UserRoleLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeXs}"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Margin" Value="0,0,8,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!--  Dev Mode bug icon: shown only for assistant messages that have DevTrace data  -->
                                    <Button
                                        x:Name="DevTraceBtn"
                                        Margin="6,0,0,0"
                                        Padding="2,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="DevTraceBtn_Click"
                                        Cursor="Hand"
                                        ToolTip="{Binding DevTraceTip, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDevTrace}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock
                                            FontSize="{StaticResource FontSizeMd}"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            Text="🐛" />
                                    </Button>
                                </StackPanel>

                                <!--  Message content blocks  -->
                                <ItemsControl
                                    Margin="0,2"
                                    ItemTemplateSelector="{StaticResource MessageBlockSelector}"
                                    ItemsSource="{Binding MessageBlocks}" />

                                <!--  Thinking/streaming indicator (bound to IsThinking)  -->
                                <Border
                                    Margin="8,4,0,0"
                                    Padding="0"
                                    Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--  Three bouncing dots  -->
                                        <StackPanel
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Margin="0,0,3,0"
                                                Fill="{DynamicResource InputHintBrush}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    AutoReverse="True"
                                                                    BeginTime="0:0:0"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.3"
                                                                    To="1"
                                                                    Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Margin="0,0,3,0"
                                                Fill="{DynamicResource InputHintBrush}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    AutoReverse="True"
                                                                    BeginTime="0:0:0.2"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.3"
                                                                    To="1"
                                                                    Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Fill="{DynamicResource InputHintBrush}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    AutoReverse="True"
                                                                    BeginTime="0:0:0.4"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.3"
                                                                    To="1"
                                                                    Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </StackPanel>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeSm}"
                                            Foreground="{DynamicResource InputHintBrush}"
                                            Text="{Binding ThinkingLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}" />
                                    </StackPanel>
                                </Border>

                                <!--  Streaming typing indicator  -->
                                <Border
                                    x:Name="TypingIndicator"
                                    Margin="0,4,0,0"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,4,0"
                                            Fill="{DynamicResource InputHintBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,4,0"
                                            Fill="{DynamicResource InputHintBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Fill="{DynamicResource InputHintBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Border>

                                <!--  Agent Action Plan Section  -->
                                <Border
                                    x:Name="PlanSection"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Plan}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!--  Cloud/unified runs keep Steps empty (tools run in Python); only show the card when it has steps, e.g. an Ollama tool awaiting confirmation  -->
                                                <DataTrigger Binding="{Binding Plan.Steps.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="{StaticResource FontSizeMd}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SoftTextBrush}"
                                            Text="{Binding ExecutionPlanLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}" />
                                        <ItemsControl ItemsSource="{Binding Plan.Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  State Icon  -->
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="{StaticResource FontSizeXl}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE712;" />
                                                                    <!--  Pending  -->
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                                            <Setter Property="Text" Value="&#xE945;" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                                            <Setter Property="Text" Value="&#xE73E;" />
                                                                            <Setter Property="Foreground" Value="ForestGreen" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Text" Value="&#xE711;" />
                                                                            <Setter Property="Foreground" Value="Crimson" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="WaitingConfirmation">
                                                                            <Setter Property="Text" Value="&#xE946;" />
                                                                            <Setter Property="Foreground" Value="Orange" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                            <Setter Property="Text" Value="&#xE71A;" />
                                                                            <Setter Property="Foreground" Value="Gray" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeMd}"
                                                                Foreground="{DynamicResource TextBrush}"
                                                                Text="{Binding Description}" />
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeXs}"
                                                                Foreground="{DynamicResource MutedTextBrush}"
                                                                Text="{Binding Output}"
                                                                TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Output}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Output}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!--  Confirm and Cancel Buttons for WaitingConfirmation state  -->
                                                            <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                                                                <Button
                                                                    x:Name="ConfirmBtn"
                                                                    Padding="12,4"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    BorderThickness="0"
                                                                    Click="ConfirmBtn_Click"
                                                                    Content="{Binding ConfirmExecutionLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}"
                                                                    Foreground="White">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="WaitingConfirmation">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button
                                                                    x:Name="CancelBtn"
                                                                    Margin="0,6,0,0"
                                                                    Padding="12,4"
                                                                    Background="Transparent"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Click="CancelBtn_Click"
                                                                    Content="{Binding CancelLabel, RelativeSource={RelativeSource AncestorType=controls:TraeMessageList}}"
                                                                    Foreground="{DynamicResource TextBrush}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="WaitingConfirmation">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Top"
                                                            FontSize="{StaticResource FontSizeXs}"
                                                            Foreground="{DynamicResource InputHintBrush}"
                                                            Text="{Binding State}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Empty state hint  -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                x:Name="EmptyStateTitleText"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeXxl}"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="Start a conversation with the Agent" />
            <TextBlock
                x:Name="EmptyStateSubtitleText"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeMd}"
                Foreground="{DynamicResource InputHintBrush}"
                Text="Describe the PLC code you want to generate or change" />
        </StackPanel>

        <!--  Scroll to bottom button  -->
        <Button
            x:Name="ScrollToBottomButton"
            Width="36"
            Height="36"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource ButtonBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Click="ScrollToBottomButton_Click"
            Cursor="Hand"
            Visibility="Collapsed">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18">
                        <Path
                            Width="14"
                            Height="14"
                            Data="M12,4 L4,12 L8,12 L8,20 L16,20 L16,12 L20,12 Z"
                            Fill="{DynamicResource TextBrush}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
