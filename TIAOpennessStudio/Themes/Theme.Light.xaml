<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeDictionaryMarker">Light</sys:String>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ActivityBarBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ActivityBarSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#EDEDED"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#D2D2D2"/>
    <!--  Scrollbar thumb needs its own tone: ButtonBackground sits too close to white panels  -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6"/>

    <SolidColorBrush x:Key="WindowTitleBarBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="WindowTitleTextBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CodePanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputHintBrush" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#555555"/>
    <SolidColorBrush x:Key="SoftTextBrush" Color="#444444"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>

    <!--  Semantic status colors: status dots, inline warnings, destructive actions  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#9E9E9E"/>

    <!--  DataGrid table theme colors (reusable across all tables)  -->
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridRowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridRowAltBrush" Color="#F5F7F9"/>
    <SolidColorBrush x:Key="GridRowHoverBrush" Color="#EAF3FB"/>
    <SolidColorBrush x:Key="GridRowSelectedBrush" Color="#CFE6F7"/>
    <SolidColorBrush x:Key="GridRowSelectedTextBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#333333"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="GridTextBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="GridAccentTextBrush" Color="#0E7C6B"/>
    <SolidColorBrush x:Key="GridMutedTextBrush" Color="#6A6A6A"/>

    <!-- Agent chat card styles (override Controls.AgentChat.xaml dark defaults so they fit the Light theme) -->
    <SolidColorBrush x:Key="AgentCardBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="AgentCardSurfaceBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="AgentCardCodeBrush" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="AgentCardCodeHeaderBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="AgentCardThoughtBodyBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="AgentCardBorderBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="AgentTextThoughtBrush" Color="#666666"/>
    <SolidColorBrush x:Key="AgentTextPrimaryBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="AgentTextSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="AgentHoverBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#E7F1FF"/>
    <SolidColorBrush x:Key="UserMessageBorderBrush" Color="#B8D7FF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>

    <!-- ThoughtBlock semantic colors -->
    <SolidColorBrush x:Key="ThoughtAnalysisBrush" Color="#4A90E2" />
    <SolidColorBrush x:Key="ThoughtCreativeBrush" Color="#9B59B6" />
    <SolidColorBrush x:Key="ThoughtWarningBrush" Color="#F39C12" />
    <SolidColorBrush x:Key="ThoughtErrorBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="ThoughtGeneralBrush" Color="#607D8B" />

    <!-- ThoughtBlock gradient background -->
    <LinearGradientBrush x:Key="ThoughtGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2F2F2" Offset="0" />
        <GradientStop Color="#F7F7F7" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DiffAddBackgroundBrush" Color="#33D4F8D4"/>
    <SolidColorBrush x:Key="DiffAddGutterBrush" Color="#FF1A7F37"/>
    <SolidColorBrush x:Key="DiffRemoveBackgroundBrush" Color="#33FFD7D5"/>
    <SolidColorBrush x:Key="DiffRemoveGutterBrush" Color="#FFCF222E"/>
    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#33DDF4FF"/>
    <SolidColorBrush x:Key="DiffHunkForegroundBrush" Color="#FF0969DA"/>
    <SolidColorBrush x:Key="DiffImaginaryLineBrush" Color="#22000000"/>

    <!--  Code Editor theme colors  -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#ADD6FF"/>
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="EditorKeywordBrush" Color="#0000FF"/>
    <SolidColorBrush x:Key="EditorTypeBrush" Color="#267F99"/>
    <SolidColorBrush x:Key="EditorNumberBrush" Color="#098658"/>
    <SolidColorBrush x:Key="EditorStringBrush" Color="#A31515"/>
    <SolidColorBrush x:Key="EditorCommentBrush" Color="#008000"/>
    <SolidColorBrush x:Key="EditorVariableBrush" Color="#001080"/>

    <!--  Map system brushes to theme brushes so default templates (ComboBox popups, menus,
          tooltips, dialogs) follow the active theme instead of leaking OS colors.
          InactiveSelectionHighlight*BrushKey alias Control*BrushKey in .NET Framework,
          so they must not be declared separately (duplicate resource key).  -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="{Binding Source={StaticResource BorderBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{Binding Source={StaticResource ButtonBackground}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Source={StaticResource AccentBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Source={StaticResource AccentForegroundBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}"/>
</ResourceDictionary>
