<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeDictionaryMarker">Dark</sys:String>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#252526" />
    <SolidColorBrush x:Key="ActivityBarBrush" Color="#333333" />
    <SolidColorBrush x:Key="ActivityBarSelectedBrush" Color="#252526" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#333333" />
    <SolidColorBrush x:Key="ButtonHover" Color="#464646" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#292929" />
    <!--  Scrollbar thumb needs its own tone: ButtonBackground sits too close to the code panel  -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#7A7A7A" />

    <SolidColorBrush x:Key="WindowTitleBarBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="WindowTitleTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="PanelBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#252526" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CodePanelBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="InputHintBrush" Color="#888888" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="SoftTextBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF" />

    <!--  Semantic status colors: status dots, inline warnings, destructive actions  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#9E9E9E" />

    <!--  DataGrid table theme colors (reusable across all tables)  -->
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="GridRowBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="GridRowAltBrush" Color="#252526" />
    <SolidColorBrush x:Key="GridRowHoverBrush" Color="#1F3A47" />
    <SolidColorBrush x:Key="GridRowSelectedBrush" Color="#2A4D5E" />
    <SolidColorBrush x:Key="GridRowSelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#252526" />
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="GridTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="GridAccentTextBrush" Color="#4EC9B0" />
    <SolidColorBrush x:Key="GridMutedTextBrush" Color="#888888" />

    <!--  Agent chat card styles (Dark theme keeps the Trae dark tones)  -->
    <SolidColorBrush x:Key="AgentCardBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AgentCardSurfaceBrush" Color="#252525" />
    <SolidColorBrush x:Key="AgentCardCodeBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="AgentCardCodeHeaderBrush" Color="#161B22" />
    <SolidColorBrush x:Key="AgentCardThoughtBodyBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AgentCardBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="AgentTextThoughtBrush" Color="#888888" />
    <SolidColorBrush x:Key="AgentTextPrimaryBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AgentTextSecondaryBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="AgentHoverBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#153A56" />
    <SolidColorBrush x:Key="UserMessageBorderBrush" Color="#245E86" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#AA000000" />

    <!-- ThoughtBlock semantic colors -->
    <SolidColorBrush x:Key="ThoughtAnalysisBrush" Color="#4A90E2" />
    <SolidColorBrush x:Key="ThoughtCreativeBrush" Color="#9B59B6" />
    <SolidColorBrush x:Key="ThoughtWarningBrush" Color="#F39C12" />
    <SolidColorBrush x:Key="ThoughtErrorBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="ThoughtGeneralBrush" Color="#607D8B" />

    <!-- ThoughtBlock gradient background -->
    <LinearGradientBrush x:Key="ThoughtGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#252525" Offset="0" />
        <GradientStop Color="#2A2A2A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DiffAddBackgroundBrush" Color="#282EA043" />
    <SolidColorBrush x:Key="DiffAddGutterBrush" Color="#7F2EA043" />
    <SolidColorBrush x:Key="DiffRemoveBackgroundBrush" Color="#28F85149" />
    <SolidColorBrush x:Key="DiffRemoveGutterBrush" Color="#7FF85149" />
    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#28388BFD" />
    <SolidColorBrush x:Key="DiffHunkForegroundBrush" Color="#7FB3D9FF" />
    <SolidColorBrush x:Key="DiffImaginaryLineBrush" Color="#1AFFFFFF" />

    <!--  Code Editor theme colors  -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#858585" />
    <SolidColorBrush x:Key="EditorKeywordBrush" Color="#569CD6" />
    <SolidColorBrush x:Key="EditorTypeBrush" Color="#4EC9B0" />
    <SolidColorBrush x:Key="EditorNumberBrush" Color="#B5CEA8" />
    <SolidColorBrush x:Key="EditorStringBrush" Color="#CE9178" />
    <SolidColorBrush x:Key="EditorCommentBrush" Color="#6A9955" />
    <SolidColorBrush x:Key="EditorVariableBrush" Color="#9CDCFE" />

    <!--  Map system brushes to theme brushes so default templates (ComboBox popups, menus,
          tooltips, dialogs) follow the active theme instead of leaking OS colors.
          InactiveSelectionHighlight*BrushKey alias Control*BrushKey in .NET Framework,
          so they must not be declared separately (duplicate resource key).  -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="{Binding Source={StaticResource BorderBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{Binding Source={StaticResource ButtonBackground}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Source={StaticResource AccentForegroundBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{Binding Source={StaticResource PanelBrush}, Path=Color}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{Binding Source={StaticResource TextBrush}, Path=Color}" />
</ResourceDictionary>
